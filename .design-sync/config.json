  "overrides": {
    "AlertDialog": { "cardMode": "single", "primaryStory": "Default" },
    "Modal": { "cardMode": "single", "primaryStory": "Default" },
    "Form": { "cardMode": "column" },
    "Tooltip": { "cardMode": "column" }
  }
}
