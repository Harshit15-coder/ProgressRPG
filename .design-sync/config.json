{
  "projectId": "53a90b3e-6574-419d-a8e1-4af3ae413270",
  "pkg": "frontend",
  "globalName": "progressRPG",
  "shape": "storybook",
  "storybookConfigDir": "frontend/.storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "readmeHeader": ".design-sync/conventions.md",
  "cssEntry": "dist-ds/frontend.css",
  "buildCmd": "cd frontend && npx vite build --config vite.ds.config.js",
  "componentSrcMap": {
    "Button": "src/components/Button/Button.tsx",
